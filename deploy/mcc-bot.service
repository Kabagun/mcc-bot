[Unit]
Description=MCC Moneyback Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/bots/mcc-bot/app
EnvironmentFile=/srv/bots/mcc-bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/bots/mcc-bot/venv/bin/python -m mcc_bot
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
