# Token issued by @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=
# Explicit Telegram USER ID of the owner. Never inferred from the first visitor.
BOT_OWNER_TELEGRAM_ID=

# Optional catalog overrides. Leave commented to use the bundled package data.
# MCC_CATALOG_PATH=/srv/bots/mcc-bot/data/cards.json
# MCC_DESCRIPTIONS_PATH=/srv/bots/mcc-bot/data/mcc_descriptions.json
# MCC_USER_REGISTRY_PATH=/srv/bots/mcc-bot/var/users.sqlite3
# MCC_STORES_PATH=/srv/bots/mcc-bot/var/stores.sqlite3

LOG_LEVEL=INFO
