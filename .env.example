# Token issued by @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=

# Keep access restricted by default. Set this to true only when the bot is
# intentionally public; otherwise provide one or more Telegram numeric IDs.
TELEGRAM_OPEN_ACCESS=false
TELEGRAM_ALLOWED_USER_IDS=

# Path to the editable catalog. Relative paths are resolved from the process
# working directory. The repository includes the current card dataset.
MCC_CATALOG_PATH=data/cards.json

LOG_LEVEL=INFO
